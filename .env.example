# Copie para .env e preencha (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key

# Opcional: chave PÚBLICA VAPID para notificações push.
# É o par da VAPID_PRIVATE_KEY configurada nos secrets da Edge Function.
# Gerar um par: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
